# Copy to Backend/.env and adjust. Never commit the real .env file.
# Every value below is read by python-decouple; real environment variables take precedence.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Development defaults. In production set DEBUG=False and list your real host names.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Production over HTTPS only (ignored when DEBUG=True):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Browser origins allowed to call the API (the React app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. SQLite (Backend/db.sqlite3) is used when this is unset, which is all you need.
# DATABASE_URL=sqlite:///path/to/another.sqlite3

# Time zone used for bare dates in query strings (?from=2026-10-01) and in management command output.
TIME_ZONE=UTC

# Rental rules: how many reserved or checked-out items a student may hold at once.
# MAX_ACTIVE_RESERVATIONS=3

# Optional API rate limits (DRF throttle rate syntax).
# THROTTLE_RATE_ANON=60/minute
# THROTTLE_RATE_USER=300/minute
# THROTTLE_RATE_LOGIN=5/minute
# THROTTLE_RATE_REGISTER=10/hour

# Optional: fixed password for the accounts created by `manage.py seed_demo_data`.
# When unset, fresh random passwords are generated and printed on every run.
# DEMO_PASSWORD=
